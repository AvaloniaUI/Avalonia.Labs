<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFrameworks>net8.0;net10.0-android;net10.0-ios;net10.0-browser</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-ios'">13.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsBrowser>$([System.String]::Copy('$(TargetFramework)').Contains('-browser'))</IsBrowser>
    <DefineConstants Condition="'$(TargetFramework)' == 'net8.0'">$(DefineConstants);INCLUDE_WINDOWS;INCLUDE_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Linux/DBusXml/org.freedesktop.portal.Notification.xml" Namespace="Avalonia.Labs.Notifications.Linux.DBus" DBusGeneratorMode="Proxy" />
    <AdditionalFiles Include="Linux/DBusXml/org.freedesktop.host.portal.Registry.xml" Namespace="Avalonia.Labs.Notifications.Linux.DBus" DBusGeneratorMode="Proxy" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' AND '$(IsBrowser)' == 'false'">
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0-android' ">
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Avalonia.Labs.Notifications.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <!-- Compiles Browser/*.ts into wwwroot with Bun as a .NET tool, as Avalonia.Browser does. -->
  <ItemGroup>
    <NotificationsScriptSource Include="Browser\*.ts;Browser\tsconfig*.json;Browser\package.json" />
  </ItemGroup>

  <Target Name="BuildNotificationsScripts" BeforeTargets="DispatchToInnerBuilds;BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(NotificationsScriptSource)" Outputs="wwwroot\notifications.js;wwwroot\notifications-service-worker.js">
    <Exec Command="dnx Bun.Unofficial.Tool --yes -- install" WorkingDirectory="Browser" />
    <Exec Command="dnx Bun.Unofficial.Tool --yes -- --bun run build" WorkingDirectory="Browser" />
  </Target>

  <!-- Packed as plain files; build/Avalonia.Labs.Notifications.targets defines the static web assets in the app. -->
  <Target Name="IncludeNotificationsPackageFiles" DependsOnTargets="BuildNotificationsScripts" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Include="wwwroot\**" Pack="true" PackagePath="staticwebassets/" CopyToOutputDirectory="Never" />
    </ItemGroup>
  </Target>

  <Import Project="$(RepositoryTargetsRoot)/PackEnable.targets" />
</Project>
